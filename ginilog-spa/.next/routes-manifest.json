{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ],
      "regex": "^/\\.well-known/apple-app-site-association(?:/)?$"
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ],
      "regex": "^/\\.well-known/assetlinks\\.json(?:/)?$"
    }
  ],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/api/:path*",
        "destination": "https://api-data-connection.ginilog.org/api/:path*",
        "regex": "^/api(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      },
      {
        "source": "/api/bookings/:path*",
        "destination": "https://api-data-connection.ginilog.org/api/bookings/:path*",
        "regex": "^/api/bookings(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/customer-portal/accommodations/[id]",
      "regex": "^/customer\\-portal/accommodations/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/customer\\-portal/accommodations/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/customer-portal/logistics/[id]",
      "regex": "^/customer\\-portal/logistics/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/customer\\-portal/logistics/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
