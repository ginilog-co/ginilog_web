{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ],
      "regex": "^/\\.well-known/apple-app-site-association(?:/)?$"
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ],
      "regex": "^/\\.well-known/assetlinks\\.json(?:/)?$"
    }
  ],
  "dynamicRoutes": [
    {
      "page": "/customer-portal/accommodations/[id]",
      "regex": "^/customer\\-portal/accommodations/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/customer\\-portal/accommodations/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/customer-portal/logistics/[id]",
      "regex": "^/customer\\-portal/logistics/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/customer\\-portal/logistics/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin-dashboard",
      "regex": "^/admin\\-dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin\\-dashboard(?:/)?$"
    },
    {
      "page": "/admin-dashboard/admin-login",
      "regex": "^/admin\\-dashboard/admin\\-login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin\\-dashboard/admin\\-login(?:/)?$"
    },
    {
      "page": "/admin-dashboard/company",
      "regex": "^/admin\\-dashboard/company(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin\\-dashboard/company(?:/)?$"
    },
    {
      "page": "/admin-dashboard/company-login",
      "regex": "^/admin\\-dashboard/company\\-login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin\\-dashboard/company\\-login(?:/)?$"
    },
    {
      "page": "/customer-portal",
      "regex": "^/customer\\-portal(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/customer\\-portal(?:/)?$"
    },
    {
      "page": "/customer-portal/accommodations",
      "regex": "^/customer\\-portal/accommodations(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/customer\\-portal/accommodations(?:/)?$"
    },
    {
      "page": "/customer-portal/dashboard",
      "regex": "^/customer\\-portal/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/customer\\-portal/dashboard(?:/)?$"
    },
    {
      "page": "/customer-portal/forgot-password",
      "regex": "^/customer\\-portal/forgot\\-password(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/customer\\-portal/forgot\\-password(?:/)?$"
    },
    {
      "page": "/customer-portal/login",
      "regex": "^/customer\\-portal/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/customer\\-portal/login(?:/)?$"
    },
    {
      "page": "/customer-portal/logistics",
      "regex": "^/customer\\-portal/logistics(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/customer\\-portal/logistics(?:/)?$"
    },
    {
      "page": "/customer-portal/orders",
      "regex": "^/customer\\-portal/orders(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/customer\\-portal/orders(?:/)?$"
    },
    {
      "page": "/customer-portal/profile",
      "regex": "^/customer\\-portal/profile(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/customer\\-portal/profile(?:/)?$"
    },
    {
      "page": "/customer-portal/register",
      "regex": "^/customer\\-portal/register(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/customer\\-portal/register(?:/)?$"
    },
    {
      "page": "/landing-page",
      "regex": "^/landing\\-page(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/landing\\-page(?:/)?$"
    },
    {
      "page": "/privacy",
      "regex": "^/privacy(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/privacy(?:/)?$"
    },
    {
      "page": "/terms",
      "regex": "^/terms(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/terms(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "Next-Router-Segment-Prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-data-connection.ginilog.org/api/:path*",
      "regex": "^/api(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ]
}