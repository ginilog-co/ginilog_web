@model Customer_Web_App.Models.UsersDataModel.AddUserRequest

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Auth Page</title>

    <!-- Your CSS file -->
    <link rel="stylesheet" href="~/forms/forms_style.css" />

    <!-- Optional: icons for mail/lock/user/eye -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.11/build/css/intlTelInput.css" />

    <link rel="shortcut icon" href="~/images/favicon1.png" />
</head>

<body>
    <div class="page">
        <!-- Brand Panel (desktop only) -->
        <aside class="brand">
            <div class="brand-inner">
                <!-- Replace logo.png with your logo path -->
                <img class="logo" src="~/images/logo1.svg" alt="Logo" />
                <h1>Welcome Back</h1>
                <p>Sign Up to continue to your dashboard and manage your projects.</p>
            </div>
        </aside>

        <!-- Form Panel -->
        <main class="form">
            <div class="card">
                <!-- Mobile header -->
                <div class="mobile-head">
                    <img class="mobile-logo" src="logo.png" alt="Logo" />
                    <h2>Welcome</h2>
                </div>

                <!-- Tabs (static UI) -->
                <div class="tabs">
                    <button class="tab active" type="button">Sign In</button>

                </div>

                <section class="panel">
                    <form asp-action="SignUp">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <!-- Full Name (hidden in sign-in; keep for sign-up page if you want) -->


                        <div class="field">
                            <label for="firstname">First Name</label>
                            <div class="input-wrap">
                                <i class="fa-regular fa-user left"></i>
                                <input asp-for="FirstName" id="firstname" type="text" placeholder="firstname" />
                            </div>
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="field">
                            <label for="lastname">Last Name</label>
                            <div class="input-wrap">
                                <i class="fa-regular fa-user left"></i>
                                <input asp-for="LastName" id="lastname" type="text" placeholder="lastname" />
                            </div>
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                        <div class="field">
                            <label for="email">Email</label>
                            <div class="input-wrap">
                                <i class="fa-regular fa-envelope left"></i>
                                <input asp-for="Email" id="email" type="email" placeholder="you@example.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="field">
                            <label for="phone">Phone Number</label>
                            <div class="input-wrap">
                                <i class="fa-regular fa-envelope left"></i>
                                <input asp-for="PhoneNo" id="phone" type="tel" placeholder="Phone Number" />
                            </div>
                            <span asp-validation-for="PhoneNo" class="text-danger"></span>
                        </div>

                        <div class="field">
                            <label for="password">Password</label>

                            <div class="input-wrap has-right">
                                <i class="fa-solid fa-lock left"></i>

                                <input asp-for="Password" id="password" type="password" placeholder="••••••••" />


                                <!-- static eye icon (no JS) -->
                                <span class="eye" aria-hidden="true">

                                    <button type="button" class="eye-btn" id="togglePassword" aria-label="Show password">
                                        <i class="fa-regular fa-eye" id="eyeIcon"></i>
                                    </button>

                                </span>

                            </div>

                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>


                        <button class="btn primary" type="button">Sign In</button>
                    </form>
                </section>

                <div class="divider"></div>
                <p class="bottom">
                    Already have an account?
                    <a href="~/Auth/SignIn">Login</a>
                </p>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.11/build/js/intlTelInput.min.js"></script>


    <script>
        const input = document.querySelector("#phone");

        const iti = window.intlTelInput(input, {
            initialCountry: "ng", // Nigeria default
            preferredCountries: ["ng", "us", "gb"],
            separateDialCode: true,
            utilsScript: "https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.11/build/js/utils.js"
        });

        // On form submit, store full international number
        document.querySelector("form").addEventListener("submit", function () {
            const fullNumber = iti.getNumber(); // +2348012345678
            input.value = fullNumber;
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
          const passwordInput = document.getElementById("password");
          const toggleBtn = document.getElementById("togglePassword");
          const eyeIcon = document.getElementById("eyeIcon");

          if (!passwordInput || !toggleBtn || !eyeIcon) return;

          toggleBtn.addEventListener("click", function () {
            const isHidden = passwordInput.type === "password";
            passwordInput.type = isHidden ? "text" : "password";

            // change icon
            eyeIcon.classList.toggle("fa-eye", !isHidden);
            eyeIcon.classList.toggle("fa-eye-slash", isHidden);

            toggleBtn.setAttribute("aria-label", isHidden ? "Hide password" : "Show password");
          });
        });
    </script>

</body>
</html>

